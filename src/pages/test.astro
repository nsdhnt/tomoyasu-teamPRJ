---
import Layout from "../layouts/Layout.astro";
import Graph from "../components/graph.astro";
import { Image } from "astro:assets";
import testItemImg from "../assets/testItemImg.png";
import testItemArrow from "../assets/testItemArrow.png";
import recommendFunction from "../assets/recommendFunction.png";
import returnButton from "../assets/return_button.png";


// 質問＆回答データ
const questions = [
  {
    step: 1,
    title: "夜、お部屋の明かりを点けるとき、どんな光がほしい？",
    name: "light",
    answers: [
      { id: "light1", text: "心が落ち着く、あたたかい光", score: { comfort: 3, material: 1 } },
      { id: "light2", text: "思わず見惚れるおしゃれな光", score: { design: 3, material: 1 } },
      { id: "light3", text: "他にはない、印象に残る光", score: { originality: 3, design: 1 } },
      { id: "light4", text: "手元が見やすく便利な光", score: { function: 3, comfort: 1 } },
    ]
  },
  {
    step: 2,
    title: "お気に入りの『お皿』を使うなら、どんな一皿に惹かれる？",
    name: "dish",
    answers: [
      { id: "dish1", text: "手に馴染むほっこりした質感", score: { comfort: 2, material: 3 } },
      { id: "dish2", text: "リム（縁）のラインが綺麗", score: { design: 3, comfort: 1 } },
      { id: "dish3", text: "テーブルの上でパッと目を引く", score: { originality: 3, design: 1 } },
      { id: "dish4", text: "軽くて頑丈、毎日使えるお皿", score: { function: 3, comfort: 1 } },
    ]
  },
  {
    step: 3,
    title: "キッチンや洗面所の壁に『タイル』を貼るとしたら、どんな空間に仕上げたい？",
    name: "tile",
    answers: [
      { id: "tile1", text: "空間全体が優しい印象になるもの", score: { material: 3, comfort: 2 } },
      { id: "tile2", text: "すっきりと洗練されたモダンな空間", score: { design: 3, comfort: 1 } },
      { id: "tile3", text: "自分のこだわりを詰め込んだ特別な空間", score: { originality: 3, design: 1 } },
      { id: "tile4", text: "お手入れがとにかく楽なもの", score: { function: 3, comfort: 1 } },
    ]
  },
  {
    step: 4,
    title: "家で過ごす時間、あなたにとって一番大切な『おうちの役割』はどれ？",
    name: "role",
    answers: [
      { id: "role1", text: "心と体を完全にリセットする場所", score: { comfort: 3, material: 1 } },
      { id: "role2", text: "空間そのものの美しさを愛でる場所", score: { design: 3, comfort: 1 } },
      { id: "role3", text: "自分の「好き」を100%爆発させる場所", score: { originality: 3, design: 1 } },
      { id: "role4", text: "ストレスなく快適に暮らせる場所", score: { function: 3, comfort: 1 } },
    ]
  },
  {
    step: 5,
    title: "暮らしの道具（家具や雑貨）を新しくお迎えするとき、一番心が動く瞬間は？",
    name: "newTool",
    answers: [
      { id: "newTool1", text: "使い込むほどに味が出る表情を見たとき", score: { material: 3, design: 1 } },
      { id: "newTool2", text: "包み込まれるような安心感を感じたとき", score: { comfort: 3, material: 1 } },
      { id: "newTool3", text: "暮らしが便利になると確信したとき", score: { function: 3, comfort: 1 } },
      { id: "newTool4", text: "運命を感じたとき", score: { originality: 3, design: 1 } },
    ]
  }
];

// 全質問数（STEPの最大値に自動的に代入されます）
const totalSteps = questions.length;
---

<style lang="scss">
  // （既存のスタイルをそのまま引き継ぎます）
  .test{
    width: 100%;
    max-width: 393px;
    margin: 0 auto;
    padding-top: 64px;
    display: flex;
    flex-direction: column;
    align-items: center;
    &.hidden{
      display: none;
    }
    h2{
      font-size: 20px;
      text-align: center;
      width: 70%;
      height: 87px;
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 62px auto;
    }
    .answer{
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      column-gap: 28px;
      row-gap: 11px;
      li{
        list-style: none;
        width: 162px;
        height: 138px;
        background-color: #fff;
        border: solid 4px #EAE5C6;
        border-radius: 8px;
        box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.25);
        transition: 0.5s;
        &.select{
          background-color: #EAE5C6;
        }
        label{
          display: block;
          width: 100%;
          height: 100%;
          padding: 0 5px;
          font-size: 20px;
          cursor: pointer;
          display: flex;
          justify-content: center;
          align-items: center;
          input{
            display: none;
          }
        }
      }
    }
    .stepNum{
      font-size: 20px;
      width: 90px;
      height: 29px;
      margin-top: 27px;
      margin-bottom: 47px;
    }
    .buttonWrap{
      display: flex;
      align-items: center;
      gap: 60px;
      .returnButton{
        width: 44px;
        height: 44px;
        background-color: #D9D9D9;
        border-radius: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 2px 5px 0 rgba(0, 0, 0, 0.18);
        transition: 0.3s;
        img{
          width: 24px;
          height: 24px;
        }
        &.active{
          transform: translateX(2px) translateY(5px);
          box-shadow: 0 0 0 rgba(0, 0, 0, 0.18);
        }
      }
      .nextButton, .judgeButton {
        font-size: 20px;
        width: 222px;
        height: 58px;
        color: #fff;
        background-color: #492100;
        border-radius: 50px;
        box-shadow: 5px 5px 0 rgba(0, 0, 0, 0.18);
        transition: 0.3s;
        &.active{
          transform: translateX(5px) translateY(5px);
          box-shadow: 0 0 0 rgba(0, 0, 0, 0.18);
        }
      }
    }
  }

  .result{
    padding-top: 100px;
    &.hidden{
      display: none;
    }
    .graph{
      width: 270px;
      height: 383px;
      margin: 0 auto;
    }
    .thinking{
      p{
        display: flex;
        padding: 5px 20px;
        &:first-child{
          font-size: 20px;
          justify-content: flex-start;
        }
        &:nth-child(2){
          font-size: 36px;
          justify-content: center;
          background: url("../assets/test-line-function.png");
          background-repeat: no-repeat;
          background-position: center bottom;
        }
        &:last-child{
          font-size: 20px;
          justify-content: flex-end;
        }
      }
    }
    .testItemList{
      padding: 64px 0;
      display: flex;
      flex-direction: column;
      gap: 64px;
      a{
        color: black;
        .testItemWrap{
          position: relative;
          padding: 0 14px;
          height: 124px;
          transition: 0.5s;
          &:hover{
            transform: translateY(-5px);
          }
          .testItemImg{
            position: absolute;
            width: 122px;
            height: 122px;
            border-radius: 100px;
            background-color: #ACD3CC;
            border: solid 1px black;
            z-index: 10;
          }
          .testItemText{
            position: absolute;
            top: 7px;
            right: 20px;
            width: 290px;
            height: 108px;
            padding-top: 10px;
            padding-left: 70px;
            background-color: #fff;
            border: solid 1px black;
            box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.25);
            z-index: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
            p{
              &:first-child{
                font-size: 20px;
              }
              &:nth-child(2){
                font-size: 14px;
              }
            }
            img{
              position: absolute;
              top: 0;
              right: 0;
              width: 30px;
              height: 30px;
            }
          }
        }
      }
    }
    .recommend{
      margin: 0 auto;
      width: fit-content;
      p{
        font-size: 20px;
        padding-bottom: 22px;
      }
    }
  }
</style>

<Layout>
  {questions.map((q, index) => {
    const isFirst = index === 0;
    const isLast = index === questions.length - 1;
    return (
      <div 
        class={`test t${q.step} ${isFirst ? '' : 'hidden'}`} 
        data-step={q.step}
      >
        <h2>{q.title}</h2>
        <ul class="answer">
          {q.answers.map((ans) => (
            <li>
              <label>
                <input 
                  type="radio" 
                  value={ans.id} 
                  name={q.name}
                  data-originality={ans.score.originality || 0}
                  data-comfort={ans.score.comfort || 0}
                  data-material={ans.score.material || 0}
                  data-design={ans.score.design || 0}
                  data-function={ans.score.function || 0}
                />
                {ans.text}
              </label>
            </li>
          ))}
        </ul>
        <p class="stepNum">STEP{q.step}/{totalSteps}</p>
        <div class="buttonWrap">
          {!isFirst && (
            <button class="returnButton" type="button">
              <Image src={returnButton} alt="戻る" />
            </button>
          )}
          
          {/* 最後の質問なら「診断する」、途中なら「次へ」を表示 */}
          {isLast ? (
            <button class="judgeButton" type="button">診断する</button>
          ) : (
            <button class="nextButton" type="button">次へ</button>
          )}
        </div>
      </div>
    );
  })}

  {/* 結果画面 */}
  <div class="result t{totalSteps + 1} hidden">
    <div class="graph">
      <Graph />
    </div>
    <div class="thinking">
      <p>あなたは</p>
      <p>機能性 重視</p>
      <p>な考え方です</p>
    </div>
    <div class="testItemList">
      <a href="#">
        <div class="testItemWrap">
          <div class="testItemImg">
            <Image src={testItemImg} alt="" />
          </div>
          <div class="testItemText">
            <p>moku</p>
            <p>商品<br>説明</p>
            <Image src={testItemArrow} alt="" />
          </div>
        </div>
      </a>
      <a href="">
        <div class="testItemWrap">
          <div class="testItemImg">
            <Image src={testItemImg} alt="" />
          </div>
          <div class="testItemText">
            <p>moku</p>
            <p>商品<br>説明</p>
            <Image src={testItemArrow} alt="" />
          </div>
        </div>
      </a>
    </div>
    <div class="recommend">
      <p>こんな部屋をおすすめ</p>
      <picture>
        <Image src={recommendFunction} alt="" />
      </picture>
    </div>
  </div>
</Layout>

<script>
  let count = 1;
  // 質問数
  const totalQuestions = document.querySelectorAll(".test").length;

  // 表示の切り替え処理
  function switchDisplay(targetCount: number) {
    const tests = document.querySelectorAll(".test");
    const result = document.querySelector(".result");

    // 全ての質問と結果を一旦非表示
    tests.forEach((t) => t.classList.add("hidden"));
    result?.classList.add("hidden");

    if (targetCount <= totalQuestions) {
      // 途中の質問画面を表示
      const nextTest = document.querySelector(`.t${targetCount}`);
      nextTest?.classList.remove("hidden");
    } else {
      // 結果画面の表示
      result?.classList.remove("hidden");
      calcScore();
    }
  }

  // 「戻る」処理
  function returnDisplayQuiz() {
    if (count > 1) {
      count--;
      switchDisplay(count);
    }
  }

  // 「次へ」処理
  function nextDisplayQuiz() {
    count++;
    switchDisplay(count);
  }

  // ラジオボタン選択時
  const answerLists = document.querySelectorAll(".answer");
  answerLists.forEach((list) => {
    const inputs = list.querySelectorAll('input[type="radio"]');
    inputs.forEach((input) => {
      input.addEventListener("change", () => {
        // 同じ質問グループの全選択肢から select クラスを削除
        list.querySelectorAll("li").forEach((li) => li.classList.remove("select"));
        // 現在選択されたラジオボタンの親要素(li)に select を追加
        input.closest("li")?.classList.add("select");
      });
    });
  });

  // 戻るボタンの設定
  const returnButtons = document.querySelectorAll(".returnButton");
  returnButtons.forEach((returnButton) => {
    returnButton.addEventListener("click", () => {
      returnButton.classList.add("active");
      setTimeout(() => {
        returnButton.classList.remove("active");
        returnDisplayQuiz();
      }, 200);
    });
  });

  // 次へボタンの設定
  const nextButtons = document.querySelectorAll(".nextButton");
  nextButtons.forEach((nextButton) => {
    nextButton.addEventListener("click", () => {
      // 現在の質問でラジオボタンが選択されているか確認
      const currentTest = document.querySelector(`.t${count}`);
      const checked = currentTest?.querySelector('input[type="radio"]:checked');

      if (!checked) {
        alert("選択肢を1つ選んでください");
        return;
      }

      nextButton.classList.add("active");
      setTimeout(() => {
        nextButton.classList.remove("active");
        nextDisplayQuiz();
      }, 200);
    });
  });

  // 診断するボタンの設定
  const judgeButton = document.querySelector(".judgeButton");
  judgeButton?.addEventListener("click", () => {
    const currentTest = document.querySelector(`.t${count}`);
    const checked = currentTest?.querySelector('input[type="radio"]:checked');

    if (!checked) {
      alert("選択肢を1つ選んでください");
      return;
    }

    judgeButton.classList.add("active");
    setTimeout(() => {
      judgeButton.classList.remove("active");
      nextDisplayQuiz(); 
    }, 200);
  });

  // 💡 5. 合算用の計算関数
  // HTML要素に埋め込んだ score データを自動で集計するため、diagnosticData という巨大なJSオブジェクトは不要になりました！
  function calcScore() {
    let totalOriginality = 0;
    let totalComfort = 0;
    let totalMaterial = 0;
    let totalDesign = 0;
    let totalFunction = 0;

    const checkedInputs = document.querySelectorAll('input[type="radio"]:checked') as NodeListOf<HTMLInputElement>;

    checkedInputs.forEach((ci) => {
      // HTMLの `data-xxx` 属性から点数を引っ張る
      totalOriginality += Number(ci.dataset.originality) || 0;
      totalComfort     += Number(ci.dataset.comfort) || 0;
      totalMaterial    += Number(ci.dataset.material) || 0;
      totalDesign      += Number(ci.dataset.design) || 0;
      totalFunction    += Number(ci.dataset.function) || 0;
    });

    const finalResult = [
      { name: "個性", score: totalOriginality },
      { name: "居心地", score: totalComfort },
      { name: "素材", score: totalMaterial },
      { name: "デザイン", score: totalDesign },
      { name: "機能性", score: totalFunction },
    ];

    let totalFinalResult = finalResult.reduce((sum, current) => sum + current.score, 0);

    console.log("【診断結果の比率】", 
      finalResult.map(item => {
        const ratio = totalFinalResult > 0 ? Math.floor(item.score / totalFinalResult * 100) : 0;
        return `${item.name}: ${ratio}%`;
      }).join("\n")
    );
    
  }
</script>





