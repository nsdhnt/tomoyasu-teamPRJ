  // requestAnimationFrame(raf);
  import Lenis from "lenis";

  const lenis = new Lenis({
    duration: 1.5,
    smoothWheel: true,
  });

  function raf(time) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);
</script>
<Layout>
  <Main />
</Layout>
