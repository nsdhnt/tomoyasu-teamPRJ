---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Hamburger from "../components/hamburger.astro";
import "ress";
---

<style>
  html {
    font-size: 62.5%;
  }
  * {
    padding: 0;
    margin: 0;
    box-sizing: border-box;
  }
  body {
    background: url("../assets/pc-background.png");
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center center;
    background-attachment: fixed;
  }
  .mobile {
    font-family: "Zen Kurenaido", cursive;
    margin: 0 auto;
    width: 393px;
    height: 100%;
    background: url("../assets/brick-background.png");
    background-position: 50%;
    background-repeat: repeat-y;
    overflow: hidden;
  }
  Header {
    position: fixed;
    top: 0;
  }
</style>

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hachi+Maru+Pop&family=Kaisei+Opti&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Montserrat:wght@100&family=Noto+Sans+JP:wght@300&family=Noto+Serif+JP:wght@200&family=Rampart+One&family=Rubik+80s+Fade&family=Sawarabi+Mincho&family=Zen+Kurenaido&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>チームプロジェクト</title>
  </head>
  <body>
    <div class="mobile">
      <Header />
      <slot />
      <Footer />
    </div>
  </body>
</html>