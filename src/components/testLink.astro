---
import { Image } from "astro:assets";
import testLink from "../assets/test_link.png";
---

<style lang="scss">
  .testLinkWrap{
    width: 393px;
    height: 408px;
    margin: 0 auto;
    position: relative;
    // border: solid 1px tomato;
    picture{
      position: absolute;
      top: 0;
      left: 0;
    }
    section{
      position: absolute;
      top: 0;
      left: 0;
      width: 393px;
      height: 393px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      // border: solid 1px tomato;
      h2{
        font-size: 48px;
      }
      p{
        font-size: 20px;
        padding: 10px 0;
        text-align: center;
        a{
          display: block;
          display: flex;
          justify-content: center;
          align-items: center;
          width: 187px;
          height: 56px;
          border-radius: 50px;
          background-color: #FF4E4E;
          color: #fff;
          text-decoration: none;
        }
      }
    }
  }
</style>

<div class="testLinkWrap">
  <picture>
    <Image src={testLink} alt="" />
  </picture>
  <section>
    <h2>診断</h2>
    <p>あなたに合った<br>商品を提案します</p>
    <p class="linkButton">
      <a href="#">診断する</a>
    </p>
  </section>
</div>