---
import ItemImg from "./itemImg.astro";
import { Image } from "astro:assets";
import ItemThumb from "../assets/item_thumb.png";
// import ItemIcon from "../assets/item_icon.png";
// import mainItemView from "../assets/main_item_view.png";
const { tabBlockName, mainItemView, itemIcon, itemImg2, itemImg3, itemImg4, itemImg5 } = Astro.props;

const initialItems = [
  { src: mainItemView, name: "ガレット" },
  { src: itemImg2, name: "トルテ" },
  { src: itemImg3, name: "ピュレ" },
  { src: itemImg4, name: "マカロン" },
  { src: itemImg5, name: "マジョリカ" },
];

// const moreItems = [
//   { src: , name: "" },
// ];

---


<style lang="scss">
  .itemList{
    background: url("../assets/brick_background.png");
    .mainThumb{
      position: relative;
      picture{
        &:first-child{
          img{
            width: 100%;
          }
        }
        &:last-child{
          img{
            position: absolute;
            top: 290px;
            left: 30px;
            width: 156px;
            height: 156px;
          }
        }
      }
    }
    h2{
      font-size: 36px;
      text-align: center;
      padding-top: 70px;
      padding-bottom: 45px;
    }
    .itemImgs{
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 24px;
      .itemImg {
        picture {
          img {
            box-shadow: 9px 9px 15px rgb(0, 0, 0, 0.25);
            border-radius: 17px;
          }
        }
        p {
          text-align: center;
          font-size: 20px;
        }
      }
    }
    .moreImgs{
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 24px;
      padding-top: 24px;
      &.hidden{
        display: none;
      }
      .itemImg{
        picture{
          img{
            box-shadow: 9px 9px 15px rgb(0, 0, 0, 0.25);
            border-radius: 17px;
          }
        }
      }
      p{
        text-align: center;
        font-size: 20px;
      }
    }
    
    .moreBtn{
      text-align: center;
      font-size: 20px;
      padding-top: 10px;
      padding-bottom: 20px;
      cursor: pointer;
      &:hover{
        text-decoration: underline;
        text-underline-offset: 5px;
        text-decoration-thickness: 1px;
      }
    }
  }
  
</style>


<div class="itemList">
  <div class="mainThumb">
    <picture><Image src={ItemThumb} alt="" /></picture>
    <picture><Image src={itemIcon} alt="" /></picture>
  </div>
  <h2>{tabBlockName}<br>全○種類</h2>
  <div class="itemImgs">
    <!-- <div class="itemImg">
      <picture><Image src={mainItemView} alt="" /></picture>
      <p>ガレット</p>
    </div> -->
    {initialItems.map((item) => (
      <ItemImg 
        src={item.src}
        itemName={item.name}
      />
    ))}
  </div>
  
  
  <div class="moreImgs hidden">
    <ItemImg
    src={itemImg2}
    itemName="トルテ"
    />
    <ItemImg
    src={itemImg2}
    itemName="トルテ"
    />
    <ItemImg
    src={itemImg2}
    itemName="トルテ"
    />
    <ItemImg
    src={itemImg2}
    itemName="トルテ"
    />
  </div>
  
  <p class="moreBtn">view more</p>
</div>


<script>
  const moreBtn = document.querySelector(".moreBtn");
  const moreImgs = document.querySelector(".moreImgs");
  moreBtn?.addEventListener("click", ()=>{
    moreImgs?.classList.toggle("hidden");
  });

</script>
