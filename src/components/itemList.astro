---
import ItemImg from "./itemImg.astro";
import { Image } from "astro:assets";
import ItemThumb from "../assets/item_thumb.png";
// import ItemIcon from "../assets/item_icon.png";
// import mainItemView from "../assets/main_item_view.png";
const { tabBlockName, mainItemView, itemIcon, items } = Astro.props;

const initialItems = items.slice(0, 5);
const moreItems = items.slice(5);
const totalCount = items.length;

// const initialItems = [
//   { src: mainItemView, name: "ガレット" },
//   { src: itemImg2, name: "トルテ" },
//   { src: itemImg3, name: "ピュレ" },
//   { src: itemImg4, name: "マカロン" },
//   { src: itemImg5, name: "マジョリカ" },
// ];

// const moreItems = [
//   { src: , name: "" },
// ];

---


<style lang="scss">
  .item-list{
    // background: url("../assets/brick_background.png");
    .main-thumb{
      position: relative;
      picture{
        &:first-child{
          img{
            width: 100%;
          }
        }
        &:last-child{
          img{
            position: absolute;
            top: 290px;
            left: 30px;
            width: 156px;
            height: 156px;
          }
        }
      }
    }
    h2{
      font-size: 36px;
      text-align: center;
      padding-top: 70px;
      padding-bottom: 45px;
    }
    .item-imgs, .more-imgs{
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 24px;
      width: 100%;
    }
    .more-imgs{
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 24px;
      padding-top: 24px;
      &.hidden{
        display: none;
      }
    }
    
    .more-btn{
      text-align: center;
      font-size: 30px;
      padding-top: 10px;
      padding-bottom: 20px;
      cursor: pointer;
      &:hover{
        text-decoration: underline;
        text-underline-offset: 5px;
        text-decoration-thickness: 2px;
      }
    }
  }
  
</style>


<div class="item-list">
  <div class="main-thumb">
    <picture><Image src={ItemThumb} alt="" /></picture>
    <picture><Image src={itemIcon} alt="" /></picture>
  </div>
  <h2>{tabBlockName}</h2>
  <div class="item-imgs">
    {initialItems.map((item) => (
      <ItemImg src={item.src} itemName={item.name}
      />
    ))}
  </div>
  
  {moreItems.length > 0 && (
    <>
      <div class="more-imgs hidden">
        {moreItems.map((item) => (
          <ItemImg src={item.src} itemName={item.name} />
        ))}
      </div>
      <p class="more-btn">view more</p>
    </>
  )}  
</div>


<script>
  const moreBtn = document.querySelector(".more-btn");
  const moreImgs = document.querySelector(".more-imgs");
  moreBtn?.addEventListener("click", ()=>{
    moreImgs?.classList.toggle("hidden");
  });

</script>
