---
import { Image } from "astro:assets";
import Desert1 from "../assets/desert1.png";
import Desert2 from "../assets/desert2.png";
import Food1 from "../assets/food1.png";
---

<style>
    .story-wrap {
        padding-top: 6rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        .story-title {
            font-size: 3.6rem;
            color: #000;
            margin-bottom: 4rem;
        }
        .story-content {
            display: flex;
            /* overflow-y: hidden; */
            position: relative;
            padding-top: 110px;
            height: 510px;
            background-image: url(../assets/story-background.png);
            background-size: 100%;
            width: 100%;
            background-position: center center;
            display: flex;
            flex-direction: column;
            align-items: center;
            .desert1 {
                position: absolute;
                top: -23%;
                left: -10rem;
                width: 60%;
                height: 60%;
            }
            .desert2 {
                position: absolute;
                top: 25%;
                right: -15%;
                width: 40%;
                height: 35%;
                transform: rotate(98deg);
            }

            .food1 {
                position: absolute;
                left: -28%;
                bottom: -15%;
                width: 60%;
                height: 60%;
            }
            .inner-title {
                font-size: 2rem;
                border-bottom: 1px solid #fff;
                margin-bottom: 3rem;
                color: #fff;
            }
            .story-info {
                font-size: 1.5rem;
                color: #fff;
                text-align: center;
                font-weight: lighter;
                line-height: 2.5rem;
            }
        }
    }
</style>
<div class="story-wrap">
    <h1 class="story-title">Story</h1>
    <div class="story-content">
        <Image src={Desert1} alt="白皿にワッフル" class="desert1" />
        <Image src={Desert2} alt="黒皿にいちごチョコケーキ" class="desert2" />
        <Image src={Food1} alt="黒皿ご飯料理" class="food1" />
        <h2 class="inner-title">世界中の人々の人生に彩りを</h2>
        <p class="story-info">
            家具を置いた先の暮らしを想像<br />
            しながら、自分らしいくつろぎ<br />
            の空間を見つけていく。<br />
            ただ家具を選ぶのではなく、<br />
            その家具と過ごす時間や、部屋<br />
            に生まれる心地よさまで思い描<br />
            くことで、暮らしに寄り添う空<br />
            間づくりを楽しんでいただけます。
        </p>
    </div>
</div>
<script></script>
