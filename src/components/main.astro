---
import { Image } from "astro:assets";
import brickBackground from "../assets/brick_background.png";
import mainImg from "../assets/mainImg.png";
import mainImg1 from "../assets/mainImg1.png";
import explore from "../assets/explore.png";
import leftWindow from "../assets/leftWindow.png";
import rightWindow from "../assets/rightWindow.png";
---

<style lang="scss">
  .main {
    width: 393px;
    // height: 1000px;
    margin-inline: auto;
    background-image: url("../assets/brick_background.png");
    background-repeat: repeat-y;
    .mainImgWrap {
      padding: 96px calc(50% - 141px);
      overflow-x: hidden;
      overflow: scroll;
      display: flex;
      .mainImg {
        display: flex;
        transform: translateX(-100%);
        li {
          display: flex;
          gap: 0;
          justify-content: center;
          // animation: slider 12s infinite;
          padding-left: 4px;
          padding-right: 25px;
          list-style: none;
          picture {
            position: relative;
            display: block;
            img {
              width: 282px;
              display: block;
            }
            .windowWrap {
              position: absolute;
              top: 20px;
              left: 10px;
              right: 11px;
              bottom: 20px;
              z-index: 200;
              // border: solid 1px tomato;

              display: flex;
              justify-content: center;
              &:hover {
                img:first-child {
                  transform: rotateY(-120deg);
                }
                img:last-child {
                  transform: rotateY(120deg);
                }
              }
              img {
                width: 127px;
                height: 428px;
                object-fit: cover;
                &:first-child {
                  // transform: rotateY(170deg);
                  transform-origin: left;
                  transition: 2s;
                }
                &:last-child {
                  // transform: rotateY(170deg);
                  transform-origin: right;
                  transition: 2s;
                }
                // &:hover:first-child{
                //   transform: rotateY(180deg);
                // }
                // &:hover:last-child{
                //   transform: rotateY(180deg);
                // }
              }
            }
          }
        }
      }
    }
    .explore {
      display: flex;
      flex-direction: column;
      align-items: center;
      p {
        &:first-child {
          font-size: 48px;
        }
        &:nth-child(2) {
          font-size: 24px;
        }
      }
      img {
        margin: 10px 0;
        width: 22px;
      }
    }
  }

  @keyframes slider {
    0% {
      transform: translateX(0);
    }
    8% {
      transform: translateX(0);
    }
    16% {
      transform: translateX(-100%);
    }
    24% {
      transform: translateX(-100%);
    }
    33% {
      transform: translateX(-200%);
    }
    41% {
      transform: translateX(-200%);
    }
    50% {
      transform: translateX(-300%);
    }
    58% {
      transform: translateX(-300%);
    }
    66% {
      transform: translateX(-400%);
    }
    75% {
      transform: translateX(-400%);
    }
    83% {
      transform: translateX(-500%);
    }
    91% {
      transform: translateX(-500%);
    }
    100% {
      transform: translateX(-600%);
    }
  }
</style>

