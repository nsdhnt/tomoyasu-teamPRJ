---
import MainImgSlide from "./mainImgSlide.astro";
import { Image } from "astro:assets";
import mainImg from "../assets/mainImg.png";
import mainImgDrinking from "../assets/mainImgDrinking.png";
import mainImgEating from "../assets/mainImgEating.png";
import mainImgPasting from "../assets/mainImgPasting.png";
import explore from "../assets/explore.png";
---

<style lang="scss">
  .main {
    width: 393px;
    // height: 1000px;
    margin-inline: auto;
    // background-image: url("../assets/brick_background.png");
    background-repeat: repeat-y;
    .mainImgWrap {
      padding: 96px 0;
      overflow-x: hidden;
      overflow: scroll;
      display: flex;
      // border: solid 1px tomato;
      &::-webkit-scrollbar{
        display: none;
      }
      .mainImg {
        display: flex;
        // border: solid 1px tomato;
        // transform: translateX(-100%);
        img{
          border: solid 1px black;
        }
      }
    }
    .explore {
      display: flex;
      flex-direction: column;
      align-items: center;
      p {
        &:first-child {
          font-size: 48px;
        }
        &:nth-child(2) {
          font-size: 24px;
        }
      }
      img {
        margin: 10px 0;
        width: 22px;
      }
    }
  }

</style>

<main>
  <div class="main">
    <div class="mainImgWrap">
      <ul class="mainImg">
        <MainImgSlide
          src={mainImgDrinking}
        />
        <MainImgSlide
          src={mainImgEating}
        />
        <MainImgSlide
          src={mainImgPasting}
        />
      </ul>
    </div>
    <div class="explore">
      <p>colors Taiwan</p>
      <p>explore</p>
      <Image src={explore} alt="" />
    </div>
  </div>
</main>
