---
import MainImgSlide from "./mainImgSlide.astro";
import ModalWindow from "../components/modalWindow.astro";
import { Image } from "astro:assets";
import mainImg from "../assets/mainImg.png";
import modalButton from "../assets/modalButton.png";
import mainImgDrinking from "../assets/mainImgDrinking.png";
import mainImgEating from "../assets/mainImgEating.png";
import mainImgPasting from "../assets/mainImgPasting.png";
import explore from "../assets/explore.png";
import Nav from "../components/nav.astro";
import Images from "../components/images.astro";
import Story from "../components/story.astro";
---

<style lang="scss">
  @keyframes slideWindow {
    0%, 30%{
      transform: translateX(0);
    }
    35%, 65%{
      transform: translateX(-393px);
    }
    70%, 100%{
      transform: translateX(-786px);
    }
  }

  .main {
    width: 393px;
    // height: 1000px;
    margin-inline: auto;
    // background-image: url("../assets/brick_background.png");
    background-repeat: repeat-y;
    .mainImgWrap {
      padding: 96px 0;
      overflow-x: hidden;
      overflow: scroll;
      display: flex;
      position: relative;
      // border: solid 1px tomato;
      &::-webkit-scrollbar {
        display: none;
      }
      .mainImg {
        display: flex;
        animation: slideWindow 15s ease-in-out infinite;
        img {
          // border: solid 1px black;
        }
      }
    }
    .explore {
      display: flex;
      flex-direction: column;
      align-items: center;
      p {
        &:first-child {
          font-size: 48px;
        }
        &:nth-child(2) {
          font-size: 24px;
        }
      }
      img {
        margin: 10px 0;
        width: 22px;
      }
    }
    .modalWindow {
      &.hidden {
        display: none;
      }
    }
  }
</style>

<main>
  <div class="main">
    <div class="mainImgWrap">
      <ul class="mainImg">
        <MainImgSlide src={mainImgDrinking} />
        <MainImgSlide src={mainImgEating} />
        <MainImgSlide src={mainImgPasting} />
      </ul>
    </div>
    <div class="explore">
      <p>colors Taiwan</p>
      <p>explore</p>
      <Image src={explore} alt="" />
    </div>
  </div>
</main>
