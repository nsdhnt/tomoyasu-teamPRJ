<style>
    canvas {
        margin-top: 60px;
    }
</style>

<canvas id="myChart" width="200" height="200"></canvas>

<script>
    import Chart from "chart.js/auto";
    const ctx = document.getElementById("myChart");
    console.log("canvas", ctx);

    new Chart(ctx, {
        type: "pie",
        data: {
            labels: ["機能性", "個性", "居心地", "デザイン", "素材"],
            datasets: [
                {
                    data: [45, 30, 15, 10, 0],
                    backgroundColor: [
                        "#ACD3CC",
                        "#E5F5FF",
                        "#ffe66d",
                        "#6495ED",
                        "#ffffff",
                    ],
                    borderWidth: 0,
                },
            ],
        },
    });
</script>
