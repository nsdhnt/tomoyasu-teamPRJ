---
import { Image } from "astro:assets";
import modalButton from "../assets/modalButton.png";
import leftWindow from "../assets/leftWindow.png";
import rightWindow from "../assets/rightWindow.png";
const { src } = Astro.props;
---

<style lang="scss">
  li {
    display: flex;
    gap: 0;
    justify-content: center;
    padding: 0 56px;
    list-style: none;
    &:nth-child(2){
      padding: 0;
    }
    picture {
      position: relative;
      display: block;
      
      img {
        width: 282px;
        height: 468px;
        display: block;
      }

      .modalButton {
        position: absolute;
        top: 146px;
        left: 172px;
        width: 17px;
        height: 17px;
        
        // 閉じる時は、底に引っ込める
        z-index: 0; 
        transition: z-index 0s; 

        img {
          cursor: pointer;
          width: 100%;
          height: 100%;
        }

        // 開く時の設定
        &.open {
          z-index: 100; // 最前面に出す
          
          // 開く時だけ1秒待つ
          transition-delay: 1s; 
        }
      }

      .windowWrap {
        position: absolute;
        top: 20px;
        left: 10px;
        right: 11px;
        bottom: 20px;
        z-index: 90; // 通常時はボタン（0）より手前にある
        
        display: flex;
        justify-content: center;
        
        &.open {
          img:first-child {
            transform: rotateY(-120deg);
          }
          img:last-child {
            transform: rotateY(120deg);
          }
        }
        
        img {
          width: 127px;
          height: 428px;
          object-fit: cover;
          &:first-child {
            transform-origin: left;
            transition: 2s;
          }
          &:last-child {
            transform-origin: right;
            transition: 2s;
          }
        }
      }
    }
  }

  .modalWindow{
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: solid 1px black;
    z-index: 200;
  }
</style>

<li>
  <picture>
    <Image src={src} alt="" />
    
    <div class="modalButton">
      <Image src={modalButton} alt="" />
    </div>
    
    <div class="windowWrap">
      <Image src={leftWindow} alt="" />
      <Image src={rightWindow} alt="" />
    </div>
  </picture>
</li>


<script>
  document.querySelectorAll("li").forEach((li) => {
    const windowWrap = li.querySelector(".windowWrap");
    const modalButtton = li.querySelector(".modalButton");

    li.addEventListener("click", ()=>{
      windowWrap?.classList.toggle("open");
      modalButtton?.classList.toggle("open");
    });
  });

  const modalButton = document.querySelector(".modalButton");
  const overlay = document.querySelector(".overlay");
  modalButton?.addEventListener("click", ()=>{
    overlay?.classList.remove("hidden");
    console.log("ok");
  });
</script>