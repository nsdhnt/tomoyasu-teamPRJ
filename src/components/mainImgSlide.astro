---
import { Image } from "astro:assets";
import leftWindow from "../assets/leftWindow.png";
import rightWindow from "../assets/rightWindow.png";
const { src } = Astro.props;
---

<style lang="scss">
  li {
    display: flex;
    gap: 0;
    justify-content: center;
    // animation: slider 12s infinite;
    // padding-left: 60px;
    // padding-right: 60px;
    padding: 0 56px;
    list-style: none;
    // border: solid 1px tomato;
    &:nth-child(2){
      padding: 0;
    }
    picture {
      position: relative;
      display: block;
      img {
        width: 282px;
        height: 468px;
        display: block;
      }
      .windowWrap {
        position: absolute;
        top: 20px;
        left: 10px;
        right: 11px;
        bottom: 20px;
        z-index: 90;
        // border: solid 1px tomato;

        display: flex;
        justify-content: center;
        &:hover {
          img:first-child {
            transform: rotateY(-120deg);
          }
          img:last-child {
            transform: rotateY(120deg);
          }
        }
        img {
          width: 127px;
          height: 428px;
          object-fit: cover;
          &:first-child {
            // transform: rotateY(170deg);
            transform-origin: left;
            transition: 2s;
            // transform: rotateY(-120deg);
          }
          &:last-child {
            // transform: rotateY(170deg);
            transform-origin: right;
            transition: 2s;
            // transform: rotateY(120deg);
          }
        }
      }
    }
  }
</style>

<li>
  <picture>
    <Image src={src} alt="" />
    <div class="windowWrap">
      <Image src={leftWindow} alt="" />
      <Image src={rightWindow} alt="" />
    </div>
  </picture>
</li>
