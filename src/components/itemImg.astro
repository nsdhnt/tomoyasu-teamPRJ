---
import { Image } from "astro:assets";
import ItemThumb from "../assets/item_thumb.png";
import ItemIcon from "../assets/item_icon.png";
const { src, itemName } = Astro.props;
---

<style lang="scss">
  .item-img {
    picture {
      display: block;
      width: 147px;
      height: 181px;
      background-color: #fff;
      border-radius: 17px;
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        box-shadow: 9px 9px 15px rgb(0, 0, 0, 0.25);
        border-radius: inherit;
      }
    }
    &:first-child{
      picture{
        width: 318px;
      }
    }
    p {
      text-align: center;
      font-size: 20px;
    }
  }
</style>

<div class="item-img">
  <picture><Image src={src} alt="" /></picture>
  <p>{itemName}</p>
</div>