import tileKonpeitou from "../assets/tile-konpeitou.jpg";
import tileFran from "../assets/tile-fran.jpg";
import tileHarucaratto from "../assets/tile-harucaratto.jpg";
import tileMacaronBlue from "../assets/tile-macaron-blue.jpg";
import tileMacaronWhite from "../assets/tile-macaron-white.jpg";
import tileMajolica from "../assets/tile-majolica.jpg";
import tilePyureGray from "../assets/tile-pyure-gray.jpg";
import tilePyurePink from "../assets/tile-pyure-pink.jpg";
import tilePyureWhite from "../assets/tile-pyure-white.jpg";
import tileToruteBlack from "../assets/tile-torute-black.jpg";
import tileToruteWhite from "../assets/tile-torute-white.jpg";

// ARAS
import arasIcon from "../assets/aras-icon.png";
import arasThumb from "../assets/aras-thumb.jpg";

import arasFork from "../assets/aras-fork.jpg";
import arasKnife from "../assets/aras-knife.jpg";
import arasScoopPlate from "../assets/aras-scoop-plate.jpg";
import arasSpoon from "../assets/aras-spoon.jpg";
import arasWavePlate from "../assets/aras-wave-plate.jpg";

// MOKU
import mokuIcon from "../assets/moku-icon.png";
import mokuThumb from "../assets/moku-thumb.jpg";

import mokuMountain from "../assets/moku-mountain.jpg";
import mokuPeak from "../assets/moku-peak.jpg";
import mokuSereneF from "../assets/moku-serene-f.jpg";
import mokuSerenePLed from "../assets/moku-serene-p-led.jpg";
import mokuSherwood from "../assets/moku-sherwood.jpg";
import mokuSideF from "../assets/moku-side-f.jpg";
import mokuSideP from "../assets/moku-side-p.jpg";

// タイル画像データ
const tileItems = [
  { src: tileKonpeitou, name: "konpeitou" },
  { src: tileFran, name: "fran" },
  { src: tileHarucaratto, name: "harucaratto" },
  { src: tileMacaronBlue, name: "macaron" },
  { src: tileMacaronWhite, name: "macaron" },
  { src: tileMajolica, name: "majolica" },
  { src: tilePyureGray, name: "pyure" },
  { src: tilePyurePink, name: "pyure" },
  { src: tilePyureWhite, name: "pyure" },
  { src: tileToruteBlack, name: "torute" },
  { src: tileToruteWhite, name: "torute" },
];

// ARAS画像データ
const arasItems = [
  { src: arasFork, name: "FORK" },
  { src: arasKnife, name: "KNIFE" },
  { src: arasScoopPlate, name: "SCOOP PLATE" },
  { src: arasSpoon, name: "SPOON" },
  { src: arasWavePlate, name: "WAVE PLATE" },
]

// MOKU画像データ
const mokuItems = [
  { src: mokuMountain, name: "Mountain" },
  { src: mokuPeak, name: "PEAK" },
  { src: mokuSereneF, name: "SERENE F" },
  { src: mokuSerenePLed, name: "SERENE P LED" },
  { src: mokuSherwood, name: "SHERWOOD" },
  { src: mokuSideF, name: "SIDE F" },
  { src: mokuSideP, name: "SIDE P" },
];
---

<style lang="scss">
  .item-lists{
    width: 393px;
    margin: 0 auto;
    padding-bottom: 72px;
    div{
      display: none;
      &.active{
        display: block;
      }
    }
  }
</style>

<div class="item-lists">
  <div class="TILE active">
    <ItemList
      tabBlockName="TILE"
      itemThumb={tileThumb}
      itemIcon={tileIcon}
      items={tileItems}
    />
  </div>
  <div class="ARAS">
    <ItemList
      tabBlockName="ARAS"
      itemThumb={arasThumb}
      itemIcon={arasIcon}
      items={arasItems}
    />
  </div>
  <div class="MOKU">
    <ItemList
      tabBlockName="MOKU"
      itemThumb={mokuThumb}
      itemIcon={mokuIcon}
      items={mokuItems}
    />
  </div>
</div>

<script>
  window.addEventListener("toggle-items", (e)=>{
    // navで押したタブ名を取得
    const tabNameClass = e.detail.tabName;
    const itemLists = document.querySelectorAll(".item-lists > div");
    itemLists.forEach((itemList)=>{
      // 各商品一覧のactiveを削除
      itemList.classList.remove("active");
      // 押されたタブ名と同じリストを表示
      if(tabNameClass === itemList.className){
        console.log(itemList);
        itemList.classList.add("active");
      }
    });
  });
</script>