---
import ItemList from "./itemList.astro";
import { Image } from "astro:assets";
import ItemThumb from "../assets/item_thumb.png";
import tileIcon from "../assets/item_icon.png";
import mainTileView from "../assets/main_item_view.png";

// 画像のインポート
import tileKonpeitou from "../assets/tile-konpeitou.jpg";
import tileFran from "../assets/tile-fran.jpg";
import tileHarucaratto from "../assets/tile-harucaratto.jpg";
import tileMacaronBlue from "../assets/tile-macaron-blue.jpg";
import tileMacaronWhite from "../assets/tile-macaron-white.jpg";
import tileMajolica from "../assets/tile-majolica.jpg";
import tilePyureGray from "../assets/tile-pyure-gray.jpg";
import tilePyurePink from "../assets/tile-pyure-pink.jpg";
import tilePyureWhite from "../assets/tile-pyure-white.jpg";
import tileToruteBlack from "../assets/tile-torute-black.jpg";
import tileToruteWhite from "../assets/tile-torute-white.jpg";

// タイル画像データ
const tileItems = [
  { src: tileKonpeitou, name: "konpeitou" },
  { src: tileFran, name: "fran" },
  { src: tileHarucaratto, name: "harucaratto" },
  { src: tileMacaronBlue, name: "macaron" },
  { src: tileMacaronWhite, name: "macaron" },
  { src: tileMajolica, name: "majolica" },
  { src: tilePyureGray, name: "pyure" },
  { src: tilePyurePink, name: "pyure" },
  { src: tilePyureWhite, name: "pyure" },
  { src: tileToruteBlack, name: "torute" },
  { src: tileToruteWhite, name: "torute" },
];
---


<style lang="scss">
  .item-lists{
    width: 393px;
    margin: 0 auto;
    padding-bottom: 72px;
    div{
      display: none;
      &.active{
        display: block;
      }
    }
  }
</style>

<div class="item-lists">
  <div class="TILE active">
    <ItemList
      tabBlockName="TILE"
      mainItemView={mainTileView}
      itemIcon={tileIcon}
      items={tileItems}
    />
  </div>
  <div class="ARAS">
    <ItemList
      tabBlockName="ARAS"
      mainItemView={mainTileView}
      itemIcon={tileIcon}
      items={tileItems}
    />
  </div>
  <div class="MOKU">
    <ItemList
      tabBlockName="MOKU"
      mainItemView={mainTileView}
      itemIcon={tileIcon}
      items={tileItems}
    />
  </div>
</div>

<script>
  window.addEventListener("toggle-items", (e)=>{
    // navで押したタブ名を取得
    const tabNameClass = e.detail.tabName;
    // console.log(tabNameClass);
    const itemLists = document.querySelectorAll(".item-lists > div");
    itemLists.forEach((itemList)=>{
      // 各商品一覧のactiveを削除
      itemList.classList.remove("active");
      // 押されたタブ名と同じリストを表示
      if(tabNameClass === itemList.className){
        console.log(itemList);
        itemList.classList.add("active");
      }
    });
  });
</script>


