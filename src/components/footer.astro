---
import { Image } from "astro:assets";
import footerFlower from "../assets/footer-flower.png";
import footerDog from "../assets/footer-dog.png";
import logo from "../assets/logo.png";
---

<style lang="scss">
  .footer{
    // border: solid 1px black;
    width: 100%;
    min-width: 393px;
    margin: 0 auto;
    transform: translateY(10px);
    .footer-img{
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      width: 100%;
      min-width: 393px;
      // border: solid 1px skyblue;
      picture{
        // border: solid 1px tomato;
        &:first-child{
          margin-bottom: 8px;
        }
        &:nth-child(2){
          img{
            width: 144px;
            height: 192px;
          }
        }
        &:last-child{
          margin-bottom: 8px;
        }
      }
    }
    .footer-bottom{
      width: 100%;
      height: 212px;
      margin-top: -12px;
      background-color: #EAE5C6;
      // border: solid 1px tomato;
      picture{
        display: flex;
        justify-content: center;
        img{
          margin-top: 20px;
          width: 108px;
          height: 99px;
        }
      }
    }
  }
</style>

<div class="footer">
  <div class="footer-img">
    <picture>
      <Image src={footerFlower} alt="" />
    </picture>
    <picture>
      <Image src={footerDog} alt="" />
    </picture>
    <picture>
      <Image src={footerFlower} alt="" />
    </picture>
  </div>
  <div class="footer-bottom">
    <picture>
      <Image src={logo} alt="" />
    </picture>
  </div>
</div>