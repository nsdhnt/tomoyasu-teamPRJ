---
import { Image } from "astro:assets";
import diagnosisLink from "../assets/diagnosis-link.png";
---

<style lang="scss">
  .diagnosis-link-wrap{
    width: 393px;
    height: 408px;
    margin: 0 auto;
    position: relative;
    picture{
      position: absolute;
      top: 0;
      left: 0;
    }
    section{
      position: absolute;
      top: 0;
      left: 0;
      width: 393px;
      height: 393px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      h2{
        font-size: 48px;
      }
      p{
        font-size: 20px;
        padding: 10px 0;
        text-align: center;
        a{
          display: block;
          display: flex;
          justify-content: center;
          align-items: center;
          width: 187px;
          height: 56px;
          border-radius: 50px;
          background-color: #FF4E4E;
          color: #fff;
          text-decoration: none;
        }
      }
    }
  }
</style>

<div class="diagnosis-link-wrap" id="diagnosis">
  <picture>
    <Image src={diagnosisLink} alt="" />
  </picture>
  <section>
    <h2>診断</h2>
    <p>あなたに合った<br>商品を提案します</p>
    <p class="link-button">
      <a href="diagnosis/">診断する</a>
    </p>
  </section>
</div>